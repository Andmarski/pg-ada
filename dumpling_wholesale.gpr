project Dumpling_Wholesale is

   --  zmienna OS=Windows_NT istnieje tylko w Windows; wybiera wersję source/windows lub source/unix
   type Operating_System_Kind is ("Windows_NT", "unix");
   Operating_System : Operating_System_Kind := external ("OS", "unix");

   case Operating_System is
      when "Windows_NT" => for Source_Dirs use ("source", "source/windows");
      when "unix"       => for Source_Dirs use ("source", "source/unix");
   end case;
   for Object_Dir use "build/objects";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   for Create_Missing_Dirs use "True";

   package Builder is
      for Executable ("main.adb") use "dumpling_wholesale";
   end Builder;

   package Compiler is
      --  Ada 2012, wszystkie ostrzeżenia, asercje, informacje dla debuggera
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnata", "-g");
   end Compiler;

   package Binder is
      --  ślad stosu przy nieobsłużonym wyjątku
      for Default_Switches ("Ada") use ("-E");
   end Binder;

end Dumpling_Wholesale;
